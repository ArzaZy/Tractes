# Public values only. Safe to expose to the browser.
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key

# Optional: canonical site URL used for canonical links and sitemap (no trailing slash)
VITE_SITE_URL=https://your-domain.example

# NOTE: The app does NOT need SUPABASE_SERVICE_ROLE_KEY. Never put it in this file,
# never prefix any secret with VITE_.
